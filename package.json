{
  "name": "readstat-wasm",
  "version": "0.1.0",
  "description": "Read SPSS, Stata and SAS data files (.sav, .zsav, .por, .dta, .sas7bdat, .xpt) in the browser or Node. ReadStat compiled to WebAssembly.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.mjs" },
    "./readstat.wasm": "./readstat.wasm"
  },
  "files": ["index.mjs", "index.d.ts", "readstat.mjs", "readstat.wasm", "src/", "build.sh", "LICENSE", "LICENSE-ReadStat"],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "keywords": ["readstat", "spss", "stata", "sas", "sav", "dta", "sas7bdat", "xpt", "wasm", "webassembly", "statistics"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/NakliTechie/readstat-wasm.git" },
  "homepage": "https://github.com/NakliTechie/readstat-wasm#readme",
  "engines": { "node": ">=20" }
}
